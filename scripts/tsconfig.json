{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "**/*.ts",
    "../lib/towns.ts",
    "../lib/region.ts",
    "../lib/region-ops.ts",
    "../regions/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
