{
  "name": "hwy4-events-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Event scraping pipeline for Hwy 4 Events",
  "scripts": {
    "scrape": "tsx scrape.ts",
    "scrape:bear-valley": "tsx scrape.ts --source bear-valley",
    "scrape:gocalaveras": "tsx scrape.ts --source gocalaveras",
    "tag-weekly": "tsx tag-weekly.ts",
    "test": "SUPABASE_URL=${SUPABASE_URL:-http://localhost/test} SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY:-test-key} tsx --test lib/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@mendable/firecrawl-js": "^1.15.0",
    "@supabase/supabase-js": "^2.98.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
