# ============================================================================
# Hwy4Events environment variables
# ============================================================================
# Copy to .env.local for local dev. In production these live in Vercel
# (Project Settings > Environment Variables). The scraper GitHub Action has
# its own, smaller set — see the "GitHub Actions secrets" section at the
# bottom and .github/workflows/scrape.yml.
#
# NEXT_PUBLIC_* values ship to the browser. Everything else is server-only.
# Never commit a real .env.local.

# --- Site ------------------------------------------------------------------
# Your production URL. Code falls back to https://hwy4events.com if unset,
# so a fork MUST set this (and should also fix the hardcoded fallbacks —
# see FORKING.md).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Supabase (required) ---------------------------------------------------
# From your Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: full DB access, server-only. Used by API routes and the
# scraper scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (required) ------------------------------------------------------
# Basic Auth password for everything under /admin (see middleware.ts —
# the username is hardcoded there; change it to yours).
ADMIN_PASSWORD=

# --- Anthropic (required) --------------------------------------------------
# Powers briefings, the newsletter, price extraction, event verification,
# submission triage, and the agent cockpit reasoners.
ANTHROPIC_API_KEY=

# --- Cron + cache auth (required) ------------------------------------------
# Bearer token every /api cron route requires. Generate something long and
# random (e.g. `openssl rand -hex 32`) and set the same value in Vercel.
CRON_SECRET=
# Token for /api/revalidate (on-demand ISR cache busting; used by
# scripts/warm-map-cache.ts).
REVALIDATION_SECRET=

# --- Email (required for the newsletter) ------------------------------------
# Resend API key. Also verify your sending domain in Resend and update the
# from/reply-to addresses in app/api/newsletter/*.ts (they are hardcoded).
RESEND_API_KEY=

# --- Google Places (required for venue facts) -------------------------------
# Billing-enabled Google Cloud key with Places API (New). Powers
# /api/sync-venue-facts (venue rating/hours/phone/website). A weekly refresh
# of ~50 venues stays within Google's free credit.
GOOGLE_PLACES_API_KEY=

# --- Slack (optional) --------------------------------------------------------
# Incoming-webhook URL. Enables audit alerts, agent digests, newsletter
# notifications, and the schedule-watcher pings. Unset = those routes just
# skip the ping.
SLACK_WEBHOOK_URL=

# --- CARTO basemaps (required for the maps) ---------------------------------
# Free API key for CARTO's raster basemap tiles (no approval queue):
# https://carto.com/basemaps/apikey — powers the static venue map
# (/api/static-map) and the on-tap interactive Leaflet map. WITHOUT IT CARTO
# still serves tiles, but every one is stamped "API KEY REQUIRED", and since
# they arrive as HTTP 200 nothing in the code can detect it. NEXT_PUBLIC_
# because the interactive map fetches tiles from the browser; restrict the key
# by domain in the CARTO dashboard rather than treating it as a secret.
NEXT_PUBLIC_CARTO_API_KEY=

# --- Cloudflare Web Analytics (optional) ------------------------------------
# Free RUM analytics. The beacon token injects the client script; the rest
# power the read path + nightly snapshot into analytics_daily.
NEXT_PUBLIC_CF_BEACON_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=

# --- Google Search Console (optional) ---------------------------------------
# Service-account credentials JSON (the full file contents as one value) for
# the SEO collector. The service account must be added as a user on your GSC
# property. Unset = SEO collection is a dormant no-op.
GOOGLE_SEARCH_CONSOLE_SA_JSON=
# Defaults to sc-domain:hwy4events.com — a fork must set its own property.
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# --- Feature flags (optional) ------------------------------------------------
# "true" lets /api/reconcile-dupes actually merge duplicates (otherwise
# dry-run). Leave unset until you've watched a clean canary week.
RECONCILE_EXECUTE=

# ============================================================================
# GitHub Actions secrets (for .github/workflows/scrape.yml)
# ============================================================================
# The daily scraper runs as a GitHub Action in YOUR fork and needs these as
# repo secrets (Settings > Secrets and variables > Actions). Note the scripts
# use SUPABASE_URL (not the NEXT_PUBLIC_ name) for the same Supabase URL.
#
#   SUPABASE_URL                — same value as NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   — same as above
#   ANTHROPIC_API_KEY           — same as above
#   FIRECRAWL_API_KEY           — firecrawl.dev key; powers the config-driven
#                                 venue scrapers and bot-walled sources
#   APIFY_API_TOKEN             — optional; Facebook event discovery scraper
#
# For running scrapers locally, export the same five in your shell first —
# the scripts read process.env directly (no dotenv loader).
